# Copy to .env and fill in. .env is gitignored — never commit real values.

# JSON-RPC endpoint for the Sepolia testnet (Infura, Alchemy, or any provider).
SEPOLIA_RPC_URL=

# Private key of the deploying account. Use a throwaway key that holds nothing
# but testnet ETH. Never a key that touches mainnet.
DEPLOYER_PRIVATE_KEY=

# Optional: for `hardhat verify` so the contract source shows on Etherscan.
ETHERSCAN_API_KEY=

# Where Member 4's firmware server is reachable, used by scripts/seed.ts to
# build release locators.
FIRMWARE_BASE_URL=http://127.0.0.1:8081/
