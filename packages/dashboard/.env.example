# Copy to .env.local. Vite only exposes variables prefixed with VITE_.
# Leaving VITE_CONTRACT_ADDRESS empty runs the dashboard in demo mode against an
# in-memory registry, which is the fallback if no wallet is installed.

VITE_CONTRACT_ADDRESS=
VITE_RPC_URL=http://127.0.0.1:8545
VITE_CHAIN_ID=31337
VITE_DEVICE_MODEL=RUH-SENSOR-01
VITE_FIRMWARE_BASE_URL=http://127.0.0.1:8081/firmware/
