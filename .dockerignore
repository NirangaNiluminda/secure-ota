# Never ship host dependency trees into the image — they are rebuilt inside it,
# and on this project the host copies may be symlinks to another partition.
**/node_modules
**/.venv
**/venv

# Build output and caches
**/dist
**/artifacts
**/cache
**/typechain-types
**/__pycache__
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache

# Runtime state generated by demos
packages/device-client/.device-state
packages/device-client/firmware-slot
packages/attack-harness/.serve

# Secrets must never reach an image layer
**/.env
**/.env.*
!**/.env.example

.git
*.pdf
